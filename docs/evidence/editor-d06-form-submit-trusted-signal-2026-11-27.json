  "change": {
    "problem": "A public form's custom success event could be forged by unrelated page JavaScript, causing the configured submit action to run without an accepted backend submission.",
    "implementation": "The authored-content module keeps accepted form elements in a private WeakSet. The public renderer calls the notifier only after the form service returns an accepted successful payload. The event listener requires and consumes the private token and restricts handling to the same runtime form within the page root. A counterfeit event alone therefore cannot execute a submit action.",
    "files": [
      "public/assets/page-renderer.js",
      "public/editor-v2/core/authored-content.js",
      "public/editor-v2/app.js",
      "public/editor-v2/index.html",
      "public/visual-page.html",
      "tests/browser/editor-form-public-page.test.js",
      "tests/editor-public-asset-cache-bust.test.js"
    ],
    "save_publish_separation": "unchanged; the action runs only after the existing accepted submission response, not on draft save or preview"
  },
