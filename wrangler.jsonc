{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sanci9517-streamer-brand",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/admin",
      "/admin/*",
      "/admin-*",
      "/admin.html",
      "/editor-v2",
      "/editor-v2/index.html"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sanci9517-db",
      "database_id": "5a4a5e96-fdad-421a-a33c-143daaf33e98",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "sanci9517-media"
    }
  ],
  "vars": {
    "SITE_MEMBERSHIP_ENFORCEMENT": "enabled",
    "SITE_SCOPED_SETTINGS_ENABLED": "enabled"
  }
}
