{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sanci9517-streamer-brand",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sanci9517-db",
      "database_id": "5a4a5e96-fdad-421a-a33c-143daaf33e98",
      "migrations_dir": "migrations"
    }
  ]
}
