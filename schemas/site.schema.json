{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sanci9517/site.schema.json",
  "title": "Sanci9517 Site Settings",
  "type": "object",
  "required": ["brand", "language", "description", "links"],
  "properties": {
    "brand": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2 },
    "description": { "type": "string" },
    "links": {
      "type": "object",
      "properties": {
        "twitch": { "type": "string", "format": "uri" }
      },
      "required": ["twitch"],
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
