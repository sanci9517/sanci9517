{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sanci9517/page.schema.json",
  "title": "Sanci9517 Public Page",
  "type": "object",
  "required": ["id", "path", "title"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "pattern": "^/" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["active", "planned", "draft", "archived"] },
    "menu": { "type": "boolean" },
    "content": { "type": "string" },
    "blocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "element": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["text", "game", "twitch", "image", "link", "stats"] },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "align": { "type": "string", "enum": ["left", "center", "right"] },
        "width": { "type": "string", "enum": ["full", "half", "third", "quarter", "auto"] }
      },
      "additionalProperties": true
    },
    "block": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["text", "game", "twitch", "image", "link", "stats"] },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "width": { "type": "string", "enum": ["full", "half", "third", "quarter", "auto"] },
        "elements": {
          "type": "array",
          "items": { "$ref": "#/$defs/element" }
        }
      },
      "additionalProperties": true
    }
  }
}
