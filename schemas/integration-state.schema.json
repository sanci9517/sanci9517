{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sanci9517 Integration State",
  "type": "object",
  "required": ["ok", "integrations"],
  "properties": {
    "ok": { "type": "boolean" },
    "integrations": {
      "type": "object",
      "required": ["twitch", "youtube", "tiktok"],
      "properties": {
        "twitch": { "$ref": "#/$defs/platform" },
        "youtube": { "$ref": "#/$defs/platform" },
        "tiktok": { "$ref": "#/$defs/platform" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "platform": {
      "type": "object",
      "required": ["configured", "available"],
      "properties": {
        "configured": { "type": "boolean" },
        "available": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
